{
  "name": "cerquita",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "mobile": "pnpm --filter @cerquita/mobile start",
    "admin": "pnpm --filter @cerquita/admin dev",
    "lint": "pnpm -r --parallel run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "db:start": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor,mailpit",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint -s public,private --level warning --fail-on error",
    "db:types": "supabase gen types typescript --local --schema public > packages/shared/src/database.types.ts && prettier --write packages/shared/src/database.types.ts",
    "db:smoke": "bash supabase/tests/auth-smoke.sh",
    "e2e": "node e2e/flujos.mjs",
    "dev": "pnpm --parallel --filter @cerquita/admin --filter @cerquita/mobile dev",
    "deploy:prod": "bash scripts/deploy-production.sh"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "supabase": "^3.1.0",
    "playwright": "1.63.0"
  }
}
