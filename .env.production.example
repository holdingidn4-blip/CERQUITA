# ═══ Cerquita · variables de PRODUCCIÓN (plantilla) ═══
# Nunca subas valores reales. Cada bloque indica DÓNDE se configura.

# ── App móvil: secretos de EAS (eas env:create --environment production) ──
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<publishable key>
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
EXPO_PUBLIC_TERMS_URL=https://cerquita.pe/terminos
EXPO_PUBLIC_PRIVACY_URL=https://cerquita.pe/privacidad
EXPO_PUBLIC_PERSONAL_DATA_URL=https://cerquita.pe/datos-personales
EAS_PROJECT_ID=<uuid de eas init>
GOOGLE_MAPS_ANDROID_API_KEY=<clave restringida a pe.cerquita.app>
SENTRY_ORG=<org>
SENTRY_PROJECT=cerquita-mobile
SENTRY_AUTH_TOKEN=<token para subir source maps>

# ── Panel admin (hosting de Next.js) ──
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable key>
SUPABASE_SERVICE_ROLE_KEY=<secret key: solo servidor>

# ── Supabase Auth (Dashboard → Authentication → SMS) ──
# Proveedor recomendado: Twilio Verify o Twilio Messaging. Alternativa: MessageBird / Vonage.
SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=AC...
SUPABASE_AUTH_SMS_TWILIO_MESSAGE_SERVICE_SID=MG...
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=...
# SUPABASE_AUTH_SMS_MESSAGEBIRD_ACCESS_KEY=...
# SUPABASE_AUTH_SMS_MESSAGEBIRD_ORIGINATOR=Cerquita
# Captcha (opcional, Turnstile o hCaptcha; Supabase no soporta reCAPTCHA v3):
# SUPABASE_AUTH_CAPTCHA_SECRET=...

# ── Edge Function send-push (supabase secrets set) ──
PUSH_FUNCTION_SECRET=<cadena aleatoria larga; también en Vault como push_function_secret>
EXPO_ACCESS_TOKEN=<token de Expo con “Enhanced push security”>

# ── Scripts de despliegue ──
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_DB_PASSWORD=<contraseña de la base>
ADMIN_PHONES=+519XXXXXXXX
REVIEWER_PHONES=+519XXXXXXXX,+519XXXXXXXX
