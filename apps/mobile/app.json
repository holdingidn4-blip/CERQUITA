{
  "expo": {
    "name": "Cerquita",
    "slug": "cerquita",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cerquita",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "pe.cerquita.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E5A4B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "pe.cerquita.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E5A4B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cerquita usa tus fotos para verificar tu identidad y tu oficio.",
          "cameraPermission": "Cerquita usa la c\u00e1mara para tu selfie con DNI y fotos de tus trabajos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cerquita usa tu ubicaci\u00f3n para mostrarte profesionales cerca y ubicar tu pedido."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
