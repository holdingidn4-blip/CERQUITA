# Copia este archivo a .env.local y completa los valores (Supabase → Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# El panel NO usa la llave service_role. Solo la leen los scripts locales
# (staff:set, staff:seed, storage:cleanup). Nunca la cargues en Vercel ni con el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
